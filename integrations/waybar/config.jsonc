{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 2,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "pulseaudio",
        "memory",
        "cpu",
        "custom/cpu_temp",
        "custom/gpu_temp",
        "custom/governor",
        "tray",
        "clock",
        "clock#simpleclock",
        "custom/power"
    ],
    "custom/launcher": {
        "tooltip": false,
        "on-click": "$HOME/.local/bin/yakushi-deck",
        "on-click-right": "rofi -show drun",
        "format": "薬"
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": {
            "default": "▶",
            "mpv": "♪"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "max-length": 25
    },
    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{name}",
        "all-outputs": true,
        "disable-scroll": false
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 24
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "MUTED",
        "format-icons": {
            "headphone": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },
    "memory": {
        "format": " {used:0.1f}Gi"
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": true,
        "interval": 1
    },
    "custom/cpu_temp": {
        "exec": "$HOME/.config/waybar/scripts/temperature.sh cpu",
        "interval": 2,
        "format": " {}"
    },
    "custom/gpu_temp": {
        "exec": "$HOME/.config/waybar/scripts/temperature.sh gpu",
        "interval": 2,
        "format": "󰢮 {}"
    },
    "custom/governor": {
        "exec": "$HOME/.config/waybar/scripts/power-mode.sh",
        "interval": 2,
        "on-click": "$HOME/.local/bin/yakushi-deck",
        "tooltip": true,
        "tooltip-format": "Open Yakushi Power Management"
    },
    "tray": {
        "show-passive-items": true,
        "spacing": 10
    },
    "clock#simpleclock": {
        "tooltip": false,
        "format": " {:%I:%M %p}"
    },
    "clock": {
        "format": " {:%a %d %b}",
        "locale": "C",
        "tooltip-format": "{:%Y-%m-%d}"
    },
    "custom/power": {
        "tooltip": false,
        "on-click": "$HOME/.config/rofi/scripts/powermenu.sh",
        "format": "⏻"
    }
}
