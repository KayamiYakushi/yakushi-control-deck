@import "../hypr/colors.rasi"
configuration { modi: "drun,run,filebrowser,window"; show-icons: true; display-drun: " "; drun-display-format: "{name}"; font: "JetBrainsMono Nerd Font 12"; }
* { bg: @yak-bg; border-col: @yak-border; selected-bg: @yak-accent; selected-fg: @yak-selected-fg; text-col: @yak-fg; text-alt: @yak-muted; background-color: transparent; text-color: @text-col; }
window { transparency: "real"; background-color: @yak-rofi-bg; border: 2px; border-color: @yak-border; border-radius: 14px; width: 650px; padding: 25px; }
mainbox { background-color: transparent; children: [ inputbar, listview ]; spacing: 18px; }
inputbar { background-color: @yak-surface; border: 1px; border-color: @yak-border; border-radius: 10px; padding: 12px 16px; children: [ prompt, entry ]; }
prompt { background-color: transparent; text-color: @yak-accent; margin: 0px 10px 0px 0px; }
entry { background-color: transparent; text-color: @yak-fg; placeholder: "Type to search..."; placeholder-color: @yak-muted; }
listview { background-color: transparent; lines: 7; columns: 1; spacing: 8px; cycle: true; dynamic: true; }
element { background-color: transparent; text-color: @yak-fg; padding: 12px 16px; border-radius: 8px; }
element selected { background-color: @yak-accent; text-color: @yak-selected-fg; }
element-text { background-color: transparent; text-color: inherit; vertical-align: 0.5; }
element-icon { background-color: transparent; size: 24px; margin: 0px 12px 0px 0px; }
